<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部：模板条 + 常驻信息条 + 分类条 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_scrim"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="40dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/template_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView android:id="@+id/btn_settings" style="@style/ChipText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="@string/watermark_settings" />
            <TextView
                android:id="@+id/btn_records"
                style="@style/ChipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/title_records" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sticky_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 分类：基平台/顶平台/坡面/钢丝网格/排水沟，拍之前先定好 -->
        <HorizontalScrollView
            android:id="@+id/scroll_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/category_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 水印实时预览，位置与成片一致（跟随模板的九宫格落点） -->
    <TextView
        android:id="@+id/watermark_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="208dp"
        android:background="@drawable/bg_watermark"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="1dp"
        android:maxWidth="250dp"
        android:padding="7dp"
        android:textColor="@color/watermark_text"
        android:textSize="10sp" />

    <!-- 底部操作栏：上面一条推拉变焦，下面一排按钮 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <!-- 推拉变焦：按住往上推，画面跟着动；点档位直接跳，双指仍可捏合 -->
        <com.measurecam.widget.ZoomDialView
            android:id="@+id/zoom_dial"
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/btn_templates"
                style="@style/ChipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_templates" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/btn_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_shutter_ring"
                android:clickable="true"
                android:contentDescription="@string/shutter"
                android:focusable="true" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_gallery"
                style="@style/ChipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_gallery" />
        </LinearLayout>
    </LinearLayout>

    <!-- 保存中的轻量提示，不打断取景 -->
    <LinearLayout
        android:id="@+id/saving_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_watermark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/saving"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
