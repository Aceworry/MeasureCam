<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MeasureCam" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/page_background</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOutline">#819589</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainer">@color/page_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MeasureCam.Dialog</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MeasureCam.Camera" parent="Theme.MeasureCam">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- 模板管理这类二级页需要带 ActionBar，才有标题和返回箭头 -->
    <style name="Theme.MeasureCam.SubBase" parent="Theme.Material3.Light">
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/page_background</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOutline">#819589</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainer">@color/page_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MeasureCam.Dialog</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MeasureCam.Sub" parent="Theme.MeasureCam.SubBase" />

    <style name="ThemeOverlay.MeasureCam.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/page_background</item>
        <item name="colorSurfaceContainerHigh">@color/page_background</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="PanelSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/bg_panel</item>
    </style>
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="ChipText">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:maxLines">1</item>
    </style>

</resources>
